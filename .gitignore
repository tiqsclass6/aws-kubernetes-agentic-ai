# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Local plans (can include computed IPs and other values)
*.tfplan
tfplan
destroy.tfplan

# Local validation traces
*.trace
phase5-validate.trace
phase5-validation-trace.log

*.tfvars
*.tfvars.json

override.tf
override.tf.json
*_override.tf
*_override.tf.json

.terraform.tfstate.lock.info
.terraformrc
terraform.rc
.terraform.lock.hcl

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Service account key files, if used instead of Application Default Credentials
*.json
!package.json
terraform/terraform.tfvars
