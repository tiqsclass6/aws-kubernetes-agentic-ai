# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Local plans (can include computed IPs and other values)
*.tfplan
tfplan
destroy.tfplan
agentic.tfplan

# Local scan and release artifacts
*.sarif
release-evidence/

# Local validation traces and live-run transcripts. These capture account
# emails, project numbers, and workstation IPs, so keep them out of the repo.
*.trace
*.log
*run-results*.txt
*transcript*.txt

# Private keys, certificates, and credential material
*.pem
*.key
*.crt
*.csr
*.srl
*.p12
*.pfx
*.jks
*.kubeconfig
kubeconfig
.env
.env.*
!.env.example

*.tfvars
*.tfvars.json

override.tf
override.tf.json
*_override.tf
*_override.tf.json

.terraform.tfstate.lock.info
.terraformrc
terraform.rc
.terraform.lock.hcl

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Service account key files, if used instead of Application Default Credentials
*.json
!package.json
