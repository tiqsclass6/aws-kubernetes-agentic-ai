FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/tmp

WORKDIR /app

RUN groupadd --gid 10001 appgroup \
    && useradd \
        --uid 10001 \
        --gid 10001 \
        --no-create-home \
        --shell /usr/sbin/nologin \
        appuser

COPY requirements-aggregator.txt ./requirements-aggregator.txt

RUN pip install \
    --no-cache-dir \
    -r requirements-aggregator.txt

COPY --chown=10001:10001 \
    aggregator.py \
    ./aggregator.py

USER 10001:10001

EXPOSE 8080

CMD ["python", "aggregator.py"]