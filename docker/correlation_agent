FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/tmp

WORKDIR /app

RUN groupadd --gid 10001 appgroup \
    && useradd \
        --uid 10001 \
        --gid 10001 \
        --no-create-home \
        --shell /usr/sbin/nologin \
        appuser

COPY requirements-correlation-agent.txt ./requirements-correlation-agent.txt
RUN pip install --no-cache-dir -r requirements-correlation-agent.txt

COPY --chown=10001:10001 metrics_support.py ./metrics_support.py
COPY --chown=10001:10001 agent_runtime.py ./agent_runtime.py
COPY --chown=10001:10001 correlation_agent.py ./correlation_agent.py

USER 10001:10001
EXPOSE 8080
CMD ["python", "correlation_agent.py"]
