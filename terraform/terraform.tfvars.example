project_id   = "class-6-5-tiqs"
region       = "us-central1"
zone         = "us-central1-a"
cluster_name = "vertex-agent-lab"

# Replace this documentation-only address with your current public IP. Obtain the address outside Terraform, then add /32.
authorized_networks = [
  {
    cidr_block   = "203.0.113.10/32"
    display_name = "administrator-workstation"
  }
]

manage_firestore_database = true
firestore_location        = "us-central1"

create_reporting_secret_containers = true
slack_webhook_secret_id            = "security-slack-webhook-url"
jira_api_token_secret_id           = "security-jira-api-token"

github_owner          = "tiqsclass6"
github_repository     = "aws-kubernetes-agentic-ai"
github_default_branch = "main"

monitoring_notification_channel_ids = []

pipeline_backlog_threshold                = 100
pipeline_oldest_message_threshold_seconds = 300

policy_id = "remediation"

# Replace this placeholder with the Google identity authorized to review and sign approval decisions.
approval_signer_members = [
  "user:replace-with-reviewer@example.com",
]

kms_keyring_id       = "agentic-governance"
approval_key_id      = "approval-signing"
approval_key_version = "2"

evidence_dataset_id        = "agentic_governance_evidence"
evidence_retention_days    = 90
approval_backlog_threshold = 0
